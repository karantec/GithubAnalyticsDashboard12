PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/github_explorer
CLIENT_URL=http://localhost:3000

# GitHub personal access token (no scopes needed for public repos).
# Without it you only get 60 requests/hour; with it, 5000/hour.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Search cache TTL in seconds (5 minutes)
CACHE_TTL_SECONDS=300
